{
  "version": 1,
  "coreVersion": "esp32-3.3.11",
  "comment": "Base bundles for USB flashing - see FLASH_PLAN.md. Bootloaders are dio_80m and are flash-size independent (esptool patches the header at write time). Partition tables are chip-independent. boot_app0.bin is universal.",
  "otadata": "boot_app0.bin",
  "partitionTableOffset": 32768,
  "bootloaderByChip": {
    "ESP32-C3": "bootloader/esp32c3.bin",
    "ESP32-S2": "bootloader/esp32s2.bin",
    "ESP32-S3": "bootloader/esp32s3.bin"
  },
  "schemeByChipAndSize": {
    "ESP32-C3-4MB": "min_spiffs",
    "ESP32-S2-4MB": "min_spiffs",
    "ESP32-S3-4MB": "min_spiffs",
    "ESP32-S3-8MB": "frugal_8mb",
    "ESP32-S3-16MB": "frugal_16mb"
  },
  "partitionsByScheme": {
    "min_spiffs": "partitions/min_spiffs.bin",
    "frugal_8mb": "partitions/frugal_8mb.bin",
    "frugal_16mb": "partitions/frugal_16mb.bin"
  },
  "wholeImageChips": ["ESP8266"]
}
